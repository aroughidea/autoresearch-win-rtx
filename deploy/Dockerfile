# Container for the public demo: serves chat.py read-only, on CPU.
#
# The models are ~19M parameters, so CPU inference is genuinely fine — that is
# part of the lesson, not a compromise.
#
# BUILD CONTEXT IS THE REPO ROOT, not this directory. That is deliberate: the
# image is built from the committed chat.py, results.tsv, and checkpoints, so
# what the site serves is always a state that exists in git history. See
# deploy/README.md for the deploy command.
#
# Portability note: this also runs unchanged as a Hugging Face Docker Space
# (add Space front-matter to a README and set app_port to 7860).

FROM python:3.12-slim

# Non-root user (uid 1000 matches the Hugging Face Spaces convention).
RUN useradd -m -u 1000 user

# CPU-only torch from its own index, then the rest of the import chain. This
# set is exactly what the module-top imports of the four Python files need:
#   chat.py     -> torch, uvicorn, fastapi, pydantic
#   generate.py -> torch
#   prepare.py  -> pyarrow, requests, rustbpe, tiktoken, torch
#   train.py    -> torch
RUN pip install --no-cache-dir torch==2.9.1 --index-url https://download.pytorch.org/whl/cpu \
 && pip install --no-cache-dir \
      "fastapi>=0.100" \
      "uvicorn>=0.20" \
      "pydantic>=2" \
      "pyarrow>=21.0.0" \
      "requests>=2.32.0" \
      "rustbpe>=0.1.0" \
      "tiktoken>=0.11.0"

ENV HOME=/home/user \
    SPACE_MODE=1 \
    PORT=7860

WORKDIR /home/user/app

# chat.py imports generate.py, prepare.py and train.py; the UI reads
# results.tsv to resolve which checkpoints are Baseline and Best.
COPY --chown=user:user chat.py generate.py prepare.py train.py results.tsv ./

# Only the two checkpoints the demo compares — not the whole archive.
COPY --chown=user:user checkpoints/20260523T155743-0700_75027e8.pt \
                       checkpoints/20260523T175831-0700_e9fffd9.pt \
                       ./checkpoints/

# The tokenizer lives outside the repo on a dev machine (it is generated by
# prepare.py into a user cache), so a copy is vendored here. Destination is
# exactly where prepare.py's _default_cache_dir() resolves on Linux with
# HOME=/home/user. Only tokenizer.pkl is needed to serve; token_bytes.pt is
# used by the evaluation path, which never runs here.
COPY --chown=user:user deploy/tokenizer/ /home/user/.cache/autoresearch/datasets/tinystories/tokenizer/

USER user

EXPOSE 7860

# --checkpoint is required: the repo default (checkpoint_pre_eval.pt) is a
# build artifact and is not in the image. This picks the best kept model; the
# UI still loads both and serves them side by side.
CMD ["python", "chat.py", "--no-browser", "--checkpoint", "checkpoints/20260523T175831-0700_e9fffd9.pt"]
